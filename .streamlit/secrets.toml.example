# Copy this file to secrets.toml for local use:
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# On Streamlit Community Cloud: App settings → Secrets, then paste
# the same key names (do not commit secrets.toml).
#
# These are the exact secret / environment variable names the app reads.
# At least one transcription key is required to transcribe audio.
# YUTorah search and Torah Anytime URL lookup do not need keys.

ELEVENLABS_API_KEY = "your-elevenlabs-api-key"
ASSEMBLYAI_API_KEY = "your-assemblyai-api-key"
